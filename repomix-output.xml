        tasks=("tongue_protrusion", "sustained_ahh"),
        extract=extract_tongue_palate,
        scoring_keys=tuple(TONGUE_SCORING_KEYS), bad_direction=TONGUE_BAD_DIRECTION,
        lateral_keys=("tongue_deviation_abs",),
