    cumulative_drift: float = 0.0
    cumulative_drift_by_domain: dict[str, float] = Field(default_factory=dict)
    drift_flagged: bool = False
    drivers: list[list]
    confounders: dict
    confidence: float
    improving: bool
    sustained_sessions: int = 0
    baseline_phase: bool
    baseline_state: str
    explanation_en: str
