    assert out["svv_dynamic_cw_median"] > 5.0        # clearly abnormal
    assert out["svv_rod_susceptibility_cw"] > 3.0    # the field is dragging him
    assert SVV_STATIC_REFERENCE_DEG == pytest.approx(1.92, abs=0.01)


