    },
    "face_droop_new": {
        "en": "new drooping of the face",
        "hi": "चेहरे का नया लटकना",
        "pa": "ਚਿਹਰੇ ਦਾ ਨਵਾਂ ਲਟਕਣਾ",
    },
    "speech_loss_sudden": {
        "en": "sudden trouble speaking or understanding",
        "hi": "अचानक बोलने या समझने में दिक्कत",
        "pa": "ਅਚਾਨਕ ਬੋਲਣ ਜਾਂ ਸਮਝਣ ਵਿੱਚ ਦਿੱਕਤ",
