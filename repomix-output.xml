                    pa: " - ਇਸ ਬ੍ਰਾਊਜ਼ਰ 'ਤੇ ਅੰਦਾਜ਼ਨ" }[lang]}
                <br />
                {{ en: "Microphone", hi: "माइक", pa: "ਮਾਈਕ" }[lang]}:{" "}
                {mic === null
                  ? { en: "not available", hi: "उपलब्ध नहीं", pa: "ਉਪਲਬਧ ਨਹੀਂ" }[lang]
