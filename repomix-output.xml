@tailwind base;
@tailwind components;
@tailwind utilities;

/**
 * Inter, self-hosted, latin subset, variable weight — 48 kB.
 *
 * `body` has declared `font-feature-settings: "cv02" "cv03" "cv04" "cv11"` since the first
 * commit. Those are Inter's character variants (straight-legged a/g/l, single-storey l),
 * and with no Inter loaded they were four no-ops on whatever the OS happened to supply.
 * D-034 names Inter as the identity typeface, so the fix is to actually ship it rather
 * than delete the intent.
 *
 * Self-hosted rather than linked: a request to fonts.gstatic.com on first paint is a
 * third-party dependency on a page whose argument is that this product does not have any,
 * and the service worker precaches woff2, so it also has to work in airplane mode.
 * Devanagari and Gurmukhi are deliberately NOT subset in — the OS ships better Noto
 * coverage for both than a 300 kB download would buy us.
 */
@font-face {
  font-family: "Inter var";
  font-style: normal;
  font-weight: 100 900;
  font-display: swap;
  src: url("/fonts/inter-latin.woff2") format("woff2");
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
    U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215,
    U+FEFF, U+FFFD;
}

@layer base {
  :root {
    /* FINAL_PRODUCT_SPEC v4 Part 4 — minimal, clinical, calm. Blue and white.
       Nothing decorative. Status colours appear ONLY in status contexts. */
    --background: 0 0% 100%;           /* Surface  #FFFFFF */
    --foreground: 213 37% 13%;         /* Ink      #16212E */

    --card: 0 0% 100%;
    --card-foreground: 213 37% 13%;

    --primary: 213 70% 39%;            /* Primary blue #1E5AA8 */
    --primary-foreground: 0 0% 100%;

    --secondary: 212 55% 96%;          /* Light blue #EEF4FB */
    --secondary-foreground: 213 37% 13%;

    --muted: 212 55% 96%;
    --muted-foreground: 210 14% 42%;   /* Muted #5C6B7A */

    --accent: 212 64% 50%;             /* Accent blue #2E77D0 */
    --accent-foreground: 0 0% 100%;

    --destructive: 4 55% 51%;          /* Alert #C8453A */
    --destructive-foreground: 0 0% 100%;

    --border: 209 27% 90%;             /* Line #DDE5EC */
    --input: 209 27% 90%;
    --ring: 212 64% 50%;

    /* Status. Stable is the ACCENT blue, not green: a green "all clear" invites a family
       to stop looking, and this product explicitly cannot rule out an acute event. */
    --stable: 212 64% 50%;             /* #2E77D0 */
    --stable-soft: 212 55% 96%;
    --watch: 35 79% 57%;               /* #E8A33D */
    --watch-soft: 38 80% 95%;
    --alert: 4 55% 51%;                /* #C8453A */
    --alert-soft: 4 70% 96%;
    /* PATTERN_ATYPICAL. Deliberately not on the stable→watch→alert scale: it is not a
       worse WATCH, it is a different finding that points at a different referral. Violet
       reads as "other", where any warmer colour would read as "more urgent". */
    --atypical: 253 38% 59%;           /* #7A6BC4 — PATTERN_ATYPICAL */
    --atypical-soft: 253 50% 96%;

    /* 8px radius, 1px borders. No shadows, no gradients, no glassmorphism. */
    --radius: 0.5rem;
  }

  * {
    @apply border-border;
  }

  /* A sticky header covers whatever an anchor jumps to unless the target says otherwise. */
  html {
    scroll-behavior: smooth;
  }
  section[id],
  [data-anchor] {
    scroll-margin-top: 5.5rem;
  }

  /* The backstop. Every hook in lib/motion.ts already checks this query and returns the
     finished state, but a stray CSS transition somewhere else must not get through. */
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  body {
    @apply bg-background text-foreground antialiased;
    font-feature-settings: "cv02", "cv03", "cv04", "cv11";
  }

  /* The patient is 55-75 with low digital literacy: never let text get small. */
  .patient-scale {
    /* 20px floor on every patient-facing surface. The population is 55-75 with
       post-stroke visual changes; 18px was a compromise nobody asked for. */
    font-size: 1.25rem;
    line-height: 1.7;
  }
  /* Nothing tappable on a patient surface below 64px — a tremor-safe target. */
  .patient-scale button,
  .patient-scale a[class*="button"],
  .patient-scale input[type="checkbox"] + span {
    min-height: 4rem;
  }

  /* THE DESKTOP CASE, which this rule never had.
   *
   * The 64px minimum is about a tremor and a fingertip. On a large screen driven by a
   * MOUSE neither applies, and holding it there is what made the patient app read as a
   * phone stretched across a laptop: a 448px column of 72px buttons with 1450px of empty
   * screen either side.
   *
   * The 20px TEXT floor above is deliberately NOT relaxed here. That one is about vision —
   * a population of 55-75 with post-stroke visual change — and vision does not improve
   * because the input device changed. Only the touch target moves.
   *
   * Gated on `pointer: fine` as well as width, so a tablet in landscape keeps the full
   * touch sizing. */
  @media (min-width: 1024px) and (pointer: fine) {
    .patient-scale button,
    .patient-scale a[class*="button"] {
      min-height: 3.5rem;
    }
  }
}

@layer components {
  /* The run narration swaps whole nodes as the day changes; this is the crossfade that
     stops it snapping. Declared here rather than inline because it is a keyframe, and a
     keyframe cannot be expressed as a React transition on a node that is being replaced. */
  /* Page changes. Small and quick — this fires on every navigation inside the clinical
     app, where a long transition is a delay, not a flourish. */
  .route-in {
    animation: route-in 320ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes route-in {
    from { opacity: 0; transform: translate3d(0, 6px, 0); }
    to   { opacity: 1; transform: none; }
  }

  /* The hero's scroll hint: a line that repeatedly draws downward. Transform only. */
  .scroll-cue {
    transform-origin: top;
    animation: cue 2.4s cubic-bezier(0.76, 0, 0.24, 1) infinite;
  }
  @keyframes cue {
    0%   { transform: scaleY(0); opacity: 0; }
    35%  { transform: scaleY(1); opacity: 1; }
    75%  { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1) translateY(100%); opacity: 0; }
  }

  .run-narration {
    animation: narration-in 520ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes narration-in {
    from { opacity: 0; transform: translate3d(0, 10px, 0); }
    to   { opacity: 1; transform: none; }
  }
}

@layer utilities {
  .focus-ring {
    @apply outline-none ring-offset-2 ring-offset-background focus-visible:ring-2 focus-visible:ring-ring;
  }
}

@layer components {
  /* The tour's highlight. An outline, never an overlay: the page stays interactive while
     the tour runs, which is what keeps the FAST and emergency paths reachable. Uses the
     ring token so it cannot drift from the palette, and respects reduced motion via the
     global backstop. */
  :where([data-tour-active]) {
    outline: 3px solid hsl(var(--ring));
    outline-offset: 3px;
    border-radius: var(--radius);
  }
}

@layer utilities {
  /* ------------------------------------------------------------------ touch targets
   *
   * Scoped to COARSE POINTERS so the desktop rendering is byte-identical — a mouse does
   * not need a 44px target and widening everything for it would be a redesign.
   *
   * Measured at 320/375/390/412/768 before writing this: the layout itself is sound (no
   * horizontal overflow and no unsafe fixed widths anywhere), and every finding was an
   * interactive element shorter than 44px on the caregiver and clinician surfaces, where
   * `.patient-scale`'s 64px rule does not apply. The worst were the Emergency button at
   * 40px and the language toggle at 28px.
   *
   * HEIGHT ONLY, deliberately. The header is a fixed 64px single row and at 320px its
   * contents already measure ~320px, so adding horizontal padding to the three language
   * buttons would push it into overflow — trading a small-target problem for a broken
   * layout. Growing them vertically costs nothing, because 44px still fits inside a 64px
   * header.
   *
   * Expanding the hit area with an oversized ::after was considered and rejected for the
   * language toggle: the three buttons sit 28px apart, so 44px invisible areas would
   * OVERLAP each other, and an ambiguous target is worse than a small one for a user with
   * a tremor.
   */
  @media (pointer: coarse) {
    button,
    [role="button"],
    select,
    input[type="submit"],
    /* Links styled as buttons, and the header logo. `buttonVariants` puts `focus-ring` in
     * its base class list and the logo link carries it too, so this is the design system's
     * own marker for "interactive" rather than a guess at class names — an earlier
     * `a[class*="button"]` matched none of them, because the emitted classes are utility
     * names with no "button" in them. */
    a[class~="focus-ring"] {
      min-height: 44px;
    }

    /* Checkbox and radio inputs are drawn at their intrinsic size, so min-height does not
     * apply to them — pad the hit area instead. Safe here because these are not laid out
     * adjacently anywhere in the app. */
    input[type="checkbox"],
    input[type="radio"] {
      min-width: 24px;
      min-height: 24px;
    }

    /* The real target for a checkbox is its LABEL — these are all written as
     * `<label><input><span>text</span></label>`, so tapping the words toggles it. Measured
     * at 301x40px, which is genuinely usable and just under the floor. Raising the label
     * rather than the box keeps the control looking exactly as designed. */
    label:has(> input[type="checkbox"]),
    label:has(> input[type="radio"]) {
      min-height: 44px;
    }
  }
}

@layer base {
  /* ---------------------------------------------------- typographic base rules
   * DESIGN_LANGUAGE.md §2.2. The type SCALE lives in tailwind.config.js; these are the
   * rules that apply regardless of which token a callsite picks.
   *
   * `text-label` is uppercase by definition — the tracking in the token only reads
   * correctly in caps, so binding the transform to the token stops it being half-applied. */
  /* Mono as well as caps — the landing page uses `font-mono` 75 times for exactly
   * these micro-labels, and the monospace figure width is also what keeps a column
   * of them aligned. Bound to the token so it cannot be half-applied. */
  .text-label {
    text-transform: uppercase;
    font-family: theme('fontFamily.mono');
  }

  /* Tabular figures wherever numbers are compared or change in place. Without this a
   * counting metric jitters as glyph widths change, and a column of numbers fails to
   * align — the two places a clinical dashboard most needs to look trustworthy. */
  th, td, .tabular, .text-metric, [class*="tabular-nums"] {
    font-variant-numeric: tabular-nums;
  }

  /* Headings carry the scale's tracking even when a callsite uses a raw size. */
  h1, h2, h3 { letter-spacing: -0.018em; }
}

@layer base {
  :root {
    /* ------------------------------------------------------ motion vocabulary
     * DESIGN_LANGUAGE.md §2.3: one easing and duration vocabulary, nothing linear.
     * The reduced-motion backstop already in this file collapses all of it. */
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
    --ease-exit: cubic-bezier(0.4, 0, 1, 1);

    --dur-instant: 90ms;   /* a press */
    --dur-fast: 150ms;
    --dur-base: 240ms;
    --dur-slow: 380ms;     /* route transitions */
  }
}

@layer components {
  /* Press feedback. DESIGN_LANGUAGE §1.7 — "everything clickable gives weight back".
   * Transform and opacity only, so it never repaints, and it collapses under the global
   * reduced-motion rule rather than needing its own guard. */
  .tactile {
    transition: transform var(--dur-instant) var(--ease-spring),
                background-color var(--dur-fast) var(--ease-in-out),
                border-color var(--dur-fast) var(--ease-in-out),
                color var(--dur-fast) var(--ease-in-out),
                opacity var(--dur-fast) var(--ease-in-out);
  }
  /* Deeper on a real press than on a card hover — the control should feel like it takes
   * the weight. Transform only, so it never repaints, and the global reduced-motion rule
   * already collapses it. */
  .tactile:active { transform: scale(0.97); }

  /* An interactive CARD lifts rather than presses: this product has no shadows, so the
   * lift is carried by the border warming to the accent instead of an elevation change. */
  a:hover > .tactile,
  .tactile-lift:hover {
    border-color: hsl(var(--accent) / 0.45);
  }

  /* The severity swatch bonded to a card's leading edge — DESIGN_LANGUAGE §3, "Cards".
   * A 3px rule, not a shadow: it carries a state without adding a second badge, and
   * without breaking this product's no-shadow rule. */
  .chip-edge {
    position: relative;
    padding-inline-start: 1rem;
  }
  .chip-edge::before {
    content: "";
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 3px;
    border-start-start-radius: inherit;
    border-end-start-radius: inherit;
    background: var(--chip-edge-color, hsl(var(--border)));
  }
}
