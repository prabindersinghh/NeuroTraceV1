# NeuroTrace backend — copy to backend/.env and fill in. NEVER commit the real .env.

# ---- app ----
ENV=development
DEBUG=false
SEED=42

# ---- database (async driver; a plain postgresql:// URL is upgraded automatically) ----
DATABASE_URL=postgresql+asyncpg://neurotrace:neurotrace@localhost:5432/neurotrace

# ---- auth ----
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-me-with-a-64-byte-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- cors (comma-separated list of allowed frontend origins) ----
FRONTEND_ORIGIN=http://localhost:5173

# ---- demo ----
# Exposes POST /demo/seed without auth so the login screen's demo button works.
# Set to false on any deployment holding real data.
DEMO_MODE=true

# ---- Awaaz emergency caregiver email (disabled when host/from are blank) ----
EMERGENCY_SMTP_HOST=
EMERGENCY_SMTP_PORT=587
EMERGENCY_SMTP_FROM=
EMERGENCY_SMTP_USERNAME=
EMERGENCY_SMTP_PASSWORD=
EMERGENCY_SMTP_SECURITY=starttls
EMERGENCY_SMTP_TIMEOUT_SECONDS=5

# No media settings exist. Feature extraction runs on the patient's device and the API has
# no endpoint that accepts audio, video or images - so there is nothing to store, cap or
# expire. See docs/TRD.md section 1.
