# Deployment env (Render/Railway backend + Vercel frontend + Supabase Postgres).
# Backend service variables — same keys as backend/.env.example, production values.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
JWT_SECRET=generate-a-64-byte-random-string-per-environment
FRONTEND_ORIGIN=https://neurotrace.vercel.app
DELETE_RAW_MEDIA=true
ENV=production
DEBUG=false
SEED=42
# Leave true for the pitch build; set false once real patient data is in the database.
DEMO_MODE=true

# Frontend build variable (Vercel)
VITE_API_URL=https://neurotrace-api.onrender.com
